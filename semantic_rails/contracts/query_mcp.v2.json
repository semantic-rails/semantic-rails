{
  "$id": "https://semantic-rails.com/schemas/query_mcp.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "interface_version": "v2",
  "manifest_version": 1,
  "mcp_protocol": {
    "default": "2025-11-25",
    "supported": [
      "2025-11-25",
      "2025-03-26",
      "2024-11-05"
    ]
  },
  "producer": {
    "name": "semantic-rails",
    "version": "0.3.1"
  },
  "prompts": [
    {
      "arguments": [
        {
          "description": "Business question or analysis goal.",
          "name": "intent",
          "required": true
        },
        {
          "description": "Semantic layer package id.",
          "name": "package_id",
          "required": false
        }
      ],
      "description": "Guide an agent from a question to rows: discover, inspect, plan (and valid-values), then execute.",
      "name": "semantic-rails-query-builder"
    },
    {
      "arguments": [
        {
          "description": "Query IR JSON to review.",
          "name": "query_json",
          "required": true
        }
      ],
      "description": "Review existing Query IR with execute mode 'validate', then mode 'sql', before running it.",
      "name": "semantic-rails-query-review"
    },
    {
      "arguments": [
        {
          "description": "Segment id such as segment.jaffle.high_value_customers.",
          "name": "segment_id",
          "required": true
        }
      ],
      "description": "Validate, explain and preview a package-authored segment with the segment tool.",
      "name": "semantic-rails-segment-workflow"
    }
  ],
  "resources": [
    {
      "description": "Interface v2 tool definitions, resources and prompts. Large; use capabilities/summary for names and titles.",
      "mimeType": "application/json",
      "name": "capabilities",
      "uri": "semantic-rails://capabilities"
    },
    {
      "description": "Small capabilities index: tool names and titles, plus resources and prompts.",
      "mimeType": "application/json",
      "name": "capabilities-summary",
      "uri": "semantic-rails://capabilities/summary"
    },
    {
      "description": "Catalog summary with descriptive rows and counts. Large; use catalog/index for counts and ids.",
      "mimeType": "application/json",
      "name": "catalog-summary",
      "uri": "semantic-rails://catalog/summary"
    },
    {
      "description": "Small catalog index: counts and ids per object kind for the active package.",
      "mimeType": "application/json",
      "name": "catalog-index",
      "uri": "semantic-rails://catalog/index"
    },
    {
      "description": "Every object's full card and the alias index for the active package. Large: start with catalog-index.",
      "mimeType": "application/json",
      "name": "catalog-full",
      "uri": "semantic-rails://catalog/full"
    }
  ],
  "resultSchema": {
    "$defs": {
      "issue": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "recovery_hints": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "severity": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "Semantic Rails MCP result envelope. Tool-specific fields are additive; the status, issue, request, and package fields are stable v2.",
    "properties": {
      "api_version": {
        "const": "v2",
        "type": "string"
      },
      "error": {
        "oneOf": [
          {
            "$ref": "#/$defs/issue"
          },
          {
            "type": "null"
          }
        ]
      },
      "errors": {
        "items": {
          "$ref": "#/$defs/issue"
        },
        "type": "array"
      },
      "ok": {
        "type": "boolean"
      },
      "package_id": {
        "type": "string"
      },
      "recovery_hints": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "request_context": {
        "type": "object"
      },
      "request_id": {
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "warning",
          "error",
          "low_confidence",
          "unrealizable",
          "out_of_scope"
        ],
        "type": "string"
      },
      "timing_ms": {
        "minimum": 0,
        "type": "number"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/issue"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "status",
      "api_version",
      "request_id",
      "package_id",
      "warnings",
      "errors"
    ],
    "type": "object"
  },
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Discover"
      },
      "description": "Rank measures, metrics, dimensions, entities and segments against business terms ('revenue by store'), first, to find ids: slim cards, up to limit per kind. Empty terms list every id, 100 per kind per page (offset). verbosity='compact' adds root entities, match reasons and starter patches. Gotcha: unknown terms return status out_of_scope or low_relevance; don't treat a weak candidate as a match.",
      "inputSchema": {
        "properties": {
          "kinds": {
            "description": "Such as measure or metric; default all.",
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ]
          },
          "limit": {
            "description": "Per kind: 10, or 100 ids with empty terms.",
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "policy_context": {
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'execute' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "stage": {
            "description": "initial, post_measure, post_dimension or comparison; inferred.",
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "verbosity": {
            "default": "minimal",
            "enum": [
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "discover",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v2 result envelope.",
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Inspect"
      },
      "description": "Return one object's card (aggregations or values, time roles, related objects, policy) after discover, when its slim card isn't enough; verbosity='compact' returns the whole card. Gotcha: object_id must be a full id such as measure.jaffle.revenue_usd, not a label.",
      "inputSchema": {
        "properties": {
          "object_id": {
            "type": "string"
          },
          "policy_context": {
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'execute' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "verbosity": {
            "default": "minimal",
            "enum": [
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          }
        },
        "required": [
          "object_id"
        ],
        "type": "object"
      },
      "name": "inspect",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v2 result envelope.",
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Valid Values"
      },
      "description": "Return a dimension's governed values, before writing a where filter on it. Gotcha: dimension_id must be a full id such as dimension.jaffle_store_name; allow_live_query probes the warehouse, so use it only when no value domain is declared.",
      "inputSchema": {
        "properties": {
          "allow_live_query": {
            "default": false,
            "type": "boolean"
          },
          "dimension_id": {
            "type": "string"
          },
          "include_counts": {
            "default": false,
            "description": "Row counts, with allow_live_query.",
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "policy_context": {
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'execute' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "search": {
            "type": "string"
          }
        },
        "required": [
          "dimension_id"
        ],
        "type": "object"
      },
      "name": "valid-values",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v2 result envelope.",
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Plan"
      },
      "description": "Draft Query IR from the question; call it before 'execute' instead of writing Query IR from scratch. Returns status (ok, low_confidence, unrealizable or out_of_scope), best.query_ir, and why or warnings naming what the draft doesn't honor. detail 'best' adds intent_ir and the trace, 'full' alternatives and blocked drafts, 'debug' compose_hints. Gotcha: execute best.query_ir only when status is ok and there are no warnings.",
      "inputSchema": {
        "properties": {
          "detail": {
            "default": "query",
            "enum": [
              "query",
              "best",
              "full",
              "debug"
            ],
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "limit": {
            "default": 3,
            "description": "Drafts to consider.",
            "minimum": 1,
            "type": "integer"
          },
          "policy_context": {
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'execute' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "intent"
        ],
        "type": "object"
      },
      "name": "plan",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v2 result envelope.",
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Execute"
      },
      "description": "Validate, compile and run the best.query_ir that plan drafted (call plan first), or Query IR fixed from it. mode 'validate' only checks it; 'sql' adds the SQL without running it. Gotcha: time.end is exclusive, and query must be a JSON object. IR: select[]={expression,as}, group_by[]=[<dim id>,...], where[]={field,op,value}, metric_filters[]={expression:{kind:metric_predicate,entity,input,op,value},op:'=',value:true}, order_by[]={field,direction}. select.expression composes variants at query time: {metric} | {aggregation, measure} (any allowed aggregation) | {kind:aggregate, measure, aggregation, filter:{all:[{field,op,value}]}} | {kind:rolling, input, window:{unit,value}} | {kind:prior_period, input, offset:{unit,value}} | {kind:period_to_date, input, period} | {kind:cumulative, input} | {kind:conversion, base, converted, entity, window, matching_mode} | {kind:ratio|scoped_aggregate|aggregate_if|between|...}; the windowed kinds take no time.start. E.g. revenue from large orders: {kind:'aggregate', measure:'measure.jaffle.revenue_usd', aggregation:'sum', filter:{all:[{field:'dimension.jaffle_order_is_large_order', op:'=', value:true}]}}.",
      "inputSchema": {
        "properties": {
          "max_rows": {
            "default": 200,
            "description": "A larger result sets truncated and total_row_count.",
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "default": "run",
            "enum": [
              "run",
              "validate",
              "sql"
            ],
            "type": "string"
          },
          "policy_context": {
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "description": "Query IR (schemas/query_ir.v1.json); unknown keys are rejected.",
            "properties": {
              "time": {
                "description": "Omit for an all-time total.",
                "properties": {
                  "calendar_id": {
                    "default": "default",
                    "type": "string"
                  },
                  "end": {
                    "description": "exclusive: March 2017 is start 2017-03-01, end 2017-04-01.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fill": {
                    "default": false,
                    "description": "Return every grain bucket, empty ones too.",
                    "type": "boolean"
                  },
                  "grain": {
                    "description": "Bucket size; required by fill and inline prior_period.",
                    "enum": [
                      "",
                      "day",
                      "week",
                      "month",
                      "quarter",
                      "year",
                      "hour",
                      "minute"
                    ],
                    "type": "string"
                  },
                  "range": {
                    "description": "{last: {unit, value}}: the last N completed periods, not with start/end.",
                    "properties": {
                      "last": {
                        "additionalProperties": false,
                        "properties": {
                          "unit": {
                            "enum": [
                              "minute",
                              "hour",
                              "day",
                              "week",
                              "month",
                              "quarter",
                              "year"
                            ],
                            "type": "string"
                          },
                          "value": {
                            "minimum": 1,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "unit",
                          "value"
                        ],
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "start": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "temporal_role": {
                    "description": "Clock id (temporal_role.<x>) of the measure or metric.",
                    "type": "string"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "row_format": {
            "default": "records",
            "description": "'columns' returns column names once, rows as arrays.",
            "enum": [
              "records",
              "columns"
            ],
            "type": "string"
          },
          "sql_profile": {
            "default": "audit",
            "description": "SQL formatting; 'off' leaves the SQL out.",
            "enum": [
              "audit",
              "compact",
              "debug",
              "off"
            ],
            "type": "string"
          },
          "verbosity": {
            "default": "minimal",
            "description": "'compact' adds explain and the plans (large); 'full' is larger still.",
            "enum": [
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "execute",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v2 result envelope.",
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Segment"
      },
      "description": "Work with a package-authored segment after discover finds its id: action 'validate' checks it and its derived Query IR, 'explain' adds the SQL, 'preview' returns sample members and the member count. Gotcha: segment_id must be a full id such as segment.jaffle.high_value_customers; preview queries the warehouse.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "validate",
              "explain",
              "preview"
            ],
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Preview rows.",
            "minimum": 1,
            "type": "integer"
          },
          "policy_context": {
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "segment_id": {
            "type": "string"
          },
          "verbosity": {
            "default": "minimal",
            "enum": [
              "minimal",
              "full"
            ],
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "action"
        ],
        "type": "object"
      },
      "name": "segment",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v2 result envelope.",
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    }
  ]
}
