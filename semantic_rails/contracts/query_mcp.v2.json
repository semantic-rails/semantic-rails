{
  "$id": "https://semantic-rails.com/schemas/query_mcp.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "interface_version": "v2",
  "manifest_version": 1,
  "mcp_protocol": {
    "default": "2025-11-25",
    "supported": [
      "2025-11-25",
      "2025-06-18",
      "2025-03-26",
      "2024-11-05"
    ]
  },
  "producer": {
    "name": "semantic-rails",
    "version": "0.3.3"
  },
  "prompts": [
    {
      "arguments": [
        {
          "description": "Business question or analysis goal.",
          "name": "intent",
          "required": true
        },
        {
          "description": "Semantic layer package id.",
          "name": "package_id",
          "required": false
        }
      ],
      "description": "Guide an agent from a question to rows: discover, inspect, plan (and valid-values), then execute.",
      "name": "semantic-rails-query-builder"
    },
    {
      "arguments": [
        {
          "description": "Query call JSON to review.",
          "name": "query_json",
          "required": true
        }
      ],
      "description": "Review an existing query call with execute mode 'validate', then mode 'sql', before running it.",
      "name": "semantic-rails-query-review"
    },
    {
      "arguments": [
        {
          "description": "Segment id such as segment.high_value_customers.",
          "name": "segment_id",
          "required": true
        }
      ],
      "description": "Validate, explain and preview a package-authored segment with the segment tool.",
      "name": "semantic-rails-segment-workflow"
    }
  ],
  "resources": [
    {
      "description": "Interface v2 tool definitions, resources and prompts. Large; use capabilities/summary for names and titles.",
      "mimeType": "application/json",
      "name": "capabilities",
      "uri": "semantic-rails://capabilities"
    },
    {
      "description": "Small capabilities index: tool names and titles, plus resources and prompts.",
      "mimeType": "application/json",
      "name": "capabilities-summary",
      "uri": "semantic-rails://capabilities/summary"
    },
    {
      "description": "Catalog summary with descriptive rows and counts. Large; use catalog/index for counts and ids.",
      "mimeType": "application/json",
      "name": "catalog-summary",
      "uri": "semantic-rails://catalog/summary"
    },
    {
      "description": "Small catalog index: counts and ids per object kind for the active package.",
      "mimeType": "application/json",
      "name": "catalog-index",
      "uri": "semantic-rails://catalog/index"
    },
    {
      "description": "Every object's full card and the alias index for the active package. Large: start with catalog-index.",
      "mimeType": "application/json",
      "name": "catalog-full",
      "uri": "semantic-rails://catalog/full"
    }
  ],
  "resultSchema": {
    "$defs": {
      "issue": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "recovery_hints": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "severity": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "Semantic Rails MCP result envelope. Tool-specific fields are additive; the status, issue, request, and package fields are stable v2.",
    "properties": {
      "api_version": {
        "const": "v2",
        "type": "string"
      },
      "error": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "errors": {
        "items": {
          "$ref": "#/$defs/issue"
        },
        "type": "array"
      },
      "next": {
        "type": [
          "object",
          "string"
        ]
      },
      "ok": {
        "type": "boolean"
      },
      "package_id": {
        "type": "string"
      },
      "request_context": {
        "type": "object"
      },
      "request_id": {
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "warning",
          "error",
          "low_confidence",
          "unrealizable",
          "out_of_scope"
        ],
        "type": "string"
      },
      "timing_ms": {
        "minimum": 0,
        "type": "number"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/issue"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "status",
      "api_version",
      "request_id",
      "package_id",
      "warnings",
      "errors"
    ],
    "type": "object"
  },
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Discover"
      },
      "description": "Rank objects by business terms; empty terms list ids (100 per kind; limit, offset). Default: id, label, description; compact omits blocked cards. Gotcha: 'out_of_scope' or 'low_relevance' with no candidates; branch before using a candidate.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "kinds": {
            "description": "Unset: all but relationship, temporal_role, value_domain.",
            "items": {
              "enum": [
                "dimension",
                "dimension_value",
                "dimension_values",
                "dimensions",
                "entities",
                "entity",
                "measure",
                "measures",
                "metric",
                "metrics",
                "relationship",
                "relationships",
                "segment",
                "segments",
                "temporal_role",
                "temporal_roles",
                "value_domain",
                "value_domains"
              ],
              "type": "string"
            },
            "type": [
              "string",
              "array"
            ]
          },
          "limit": {
            "description": "Per kind: default 10, or 100 ids with empty terms.",
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "With empty terms, ids to skip per kind.",
            "minimum": 0,
            "type": "integer"
          },
          "query": {
            "description": "A partial query call (execute's query schema) to start from.",
            "type": "object"
          },
          "stage": {
            "description": "Ranking stage: initial, post_measure, post_dimension or comparison; inferred if omitted.",
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "verbosity": {
            "default": "minimal",
            "enum": [
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "discover",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Inspect"
      },
      "description": "Return one object's card: label, description, aggregations or values, temporal roles, related objects, policy. Default: the card without duplicate fields; verbosity='compact' returns the full card. Gotcha: 'object_id' must be a full id like 'measure.sales.revenue', not a label — use 'discover' first if you only have a phrase.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "query": {
            "description": "A partial query call (execute's query schema) to start from.",
            "type": "object"
          },
          "verbosity": {
            "default": "minimal",
            "enum": [
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          }
        },
        "required": [
          "object_id"
        ],
        "type": "object"
      },
      "name": "inspect",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Valid Values"
      },
      "description": "Return a dimension's governed values: from its declared value domain, or from a constrained warehouse probe with allow_live_query: true. Use it before writing a 'where' filter on a categorical dimension. Gotcha: 'dimension_id' must be a full id like 'dimension.store_name'; allow_live_query costs a warehouse round-trip, so use it only when no domain is declared.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "allow_live_query": {
            "default": false,
            "type": "boolean"
          },
          "dimension_id": {
            "type": "string"
          },
          "include_counts": {
            "default": false,
            "description": "With allow_live_query, add each value's row count.",
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "query": {
            "description": "A partial query call (execute's query schema) to start from.",
            "type": "object"
          },
          "search": {
            "type": "string"
          }
        },
        "required": [
          "dimension_id"
        ],
        "type": "object"
      },
      "name": "valid-values",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Plan"
      },
      "description": "Draft one best query call from a natural-language intent; call it before 'execute' instead of writing a call from scratch. Returns 'status' ('ok' | 'low_confidence' | 'unrealizable' | 'out_of_scope'), 'best.query', and 'why' or 'warnings' naming any part of the question the draft doesn't honor. detail='query' (default) is compact; 'best' adds intent_ir, trace and next steps; 'full' adds alternatives and blocked drafts; 'debug' adds compose_hints. Gotcha: pass 'best.query' to 'execute' only when status is 'ok' and there are no warnings.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "default": "query",
            "enum": [
              "query",
              "best",
              "full",
              "debug"
            ],
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "limit": {
            "default": 3,
            "description": "Drafts to consider; detail='full' returns the runners-up.",
            "minimum": 1,
            "type": "integer"
          },
          "now": {
            "description": "ISO date or date-time for time.last and time.this.",
            "type": "string"
          },
          "query": {
            "description": "A partial query call (execute's query schema) to start from.",
            "type": "object"
          }
        },
        "required": [
          "intent"
        ],
        "type": "object"
      },
      "name": "plan",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "api_version": {
            "const": "v2",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "parts": {
            "description": "One plan per part of a question asking several things.",
            "items": {
              "additionalProperties": true,
              "properties": {
                "best": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "spans": {
                  "items": {
                    "type": "array"
                  },
                  "type": "array"
                },
                "status": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "why": {
                  "type": "object"
                }
              },
              "required": [
                "text",
                "spans"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Execute"
      },
      "description": "Answer a call; call plan first. Only 'run' reads the warehouse; 'validate' only checks (skip it: run a call directly); 'sql' adds rendered_sql. 'ok': valid and ran, not that it answers the question. Call: select ids or {expression, as}, group_by dimension ids (alone, it lists rows), where/having [{field, op, value}] and entity filters, time (time.end is exclusive), order_by (period: time column), limit inside it; max_rows and row_format go beside query.",
      "inputSchema": {
        "$defs": {
          "Condition": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "$ref": "#/$defs/Text"
              },
              "op": {
                "$ref": "#/$defs/Op"
              },
              "value": {}
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "type": "object"
          },
          "Conditions": {
            "items": {
              "$ref": "#/$defs/Condition"
            },
            "minItems": 1,
            "type": "array"
          },
          "EntityFilter": {
            "additionalProperties": false,
            "dependentRequired": {
              "over": [
                "having"
              ]
            },
            "oneOf": [
              {
                "required": [
                  "any"
                ]
              },
              {
                "required": [
                  "none"
                ]
              },
              {
                "required": [
                  "having",
                  "over"
                ]
              }
            ],
            "properties": {
              "any": {
                "$ref": "#/$defs/Conditions"
              },
              "entity": {
                "$ref": "#/$defs/Text"
              },
              "having": {
                "$ref": "#/$defs/Conditions"
              },
              "none": {
                "$ref": "#/$defs/Conditions"
              },
              "over": {
                "enum": [
                  "all_time",
                  "window",
                  "period"
                ]
              }
            },
            "required": [
              "entity"
            ],
            "type": "object"
          },
          "Expression": {
            "anyOf": [
              {
                "$ref": "#/$defs/Ref"
              },
              {
                "required": [
                  "kind"
                ],
                "type": "object"
              }
            ],
            "description": "An id, or an object whose kind names its keys (*: required; E: expression; id: measure/metric id): aggregate/semi_additive:measure*,aggregation,filter:{all:[object]},parameters,temporal_role,window;aggregate_if:aggregation*,condition*:E,value:E;arithmetic/comparison:op*,left*:E,right*:E;between/not_between:expr*:E,low*:E,high*:E,negated;boolean:op*,args*:[E];call:name*,args:[E],distinct;case:whens*:[{when:E,then:E}],else:E;column:column*,entity,table;conversion:base*:E,converted*:E,entity*,window*,matching_mode*,constant_properties,dimension_bindings;cumulative:input*:E,partition_by,window_scope;date_add:unit*,value*:E,date*:E;distribution:function*,over*:E,p,parameters;entity_value:entity*,input*:E,where:[{kind:value_filter,op:Op,value}];in/not_in:values*:[E],expr:E,negated;literal:value*;measure:measure*,aggregation,parameters,temporal_role;metric_predicate:entity*,input*:E,op*,value*,over*:all_time|window|period,window;nullif:value*:E,null_value*:E;period_to_date:input*:E,period*,partition_by;prior_period:input*:E,offset*;ratio:numerator*:E,denominator*:E;rolling:input*:E,window*,partition_by;scoped_aggregate:measure*,aggregation,anchor,parameters,predicates:[object],temporal_role,where:[object],window;share/total:input*:id,over*:[string]"
          },
          "Op": {
            "description": "Aliases read as their word (=, ==, eq, in: is; !=, <>, neq, not in: not; >: gt; >=: gte; <: lt; <=: lte). Values: is/not: a value or a list; gt/gte/lt/lte: one value; contains/starts_with/ends_with/not_contains/not_starts_with/not_ends_with: text; missing: true or false.",
            "enum": [
              "is",
              "not",
              "gt",
              "gte",
              "lt",
              "lte",
              "contains",
              "starts_with",
              "ends_with",
              "not_contains",
              "not_starts_with",
              "not_ends_with",
              "missing",
              "=",
              "==",
              "eq",
              "in",
              "!=",
              "<>",
              "neq",
              "not in",
              ">",
              ">=",
              "<",
              "<=",
              "IS",
              "NOT",
              "GT",
              "GTE",
              "LT",
              "LTE",
              "CONTAINS",
              "STARTS_WITH",
              "ENDS_WITH",
              "NOT_CONTAINS",
              "NOT_STARTS_WITH",
              "NOT_ENDS_WITH",
              "MISSING",
              "EQ",
              "IN",
              "NEQ",
              "NOT IN"
            ]
          },
          "Ref": {
            "pattern": "^(measure|metric)\\.[^\\s]+$",
            "type": "string"
          },
          "Text": {
            "minLength": 1,
            "type": "string"
          },
          "Unit": {
            "enum": [
              "day",
              "week",
              "month",
              "quarter",
              "year"
            ]
          }
        },
        "additionalProperties": true,
        "properties": {
          "max_rows": {
            "default": 200,
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "default": "run",
            "enum": [
              "run",
              "validate",
              "sql"
            ],
            "type": "string"
          },
          "now": {
            "description": "ISO date or date-time for time.last and time.this.",
            "type": "string"
          },
          "query": {
            "additionalProperties": false,
            "patternProperties": {
              "^_": {}
            },
            "properties": {
              "group_by": {
                "items": {
                  "$ref": "#/$defs/Text"
                },
                "type": "array"
              },
              "having": {
                "items": {
                  "$ref": "#/$defs/Condition"
                },
                "type": "array"
              },
              "limit": {
                "minimum": 1,
                "type": "integer"
              },
              "observation_scope": {
                "enum": [
                  "dataset",
                  "query"
                ]
              },
              "order_by": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "direction": {
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    },
                    "field": {
                      "$ref": "#/$defs/Text"
                    }
                  },
                  "required": [
                    "field"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "routes": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/Text"
                    },
                    "to": {
                      "$ref": "#/$defs/Text"
                    },
                    "via": {
                      "items": {
                        "$ref": "#/$defs/Text"
                      },
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "via"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "select": {
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Ref"
                    },
                    {
                      "pattern": "^dimension\\.[^\\s]+$",
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "as": {
                          "$ref": "#/$defs/Text"
                        },
                        "expression": {
                          "$ref": "#/$defs/Expression"
                        }
                      },
                      "required": [
                        "expression"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "time": {
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "grain"
                    ]
                  },
                  {
                    "required": [
                      "last"
                    ]
                  },
                  {
                    "required": [
                      "this"
                    ]
                  },
                  {
                    "required": [
                      "start"
                    ]
                  },
                  {
                    "required": [
                      "end"
                    ]
                  }
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "last",
                        "this"
                      ]
                    },
                    {
                      "required": [
                        "last",
                        "start"
                      ]
                    },
                    {
                      "required": [
                        "last",
                        "end"
                      ]
                    },
                    {
                      "required": [
                        "this",
                        "start"
                      ]
                    },
                    {
                      "required": [
                        "this",
                        "end"
                      ]
                    }
                  ]
                },
                "properties": {
                  "end": {
                    "$ref": "#/$defs/Text"
                  },
                  "fill": {
                    "type": "boolean"
                  },
                  "grain": {
                    "$ref": "#/$defs/Unit"
                  },
                  "last": {
                    "additionalProperties": false,
                    "properties": {
                      "unit": {
                        "$ref": "#/$defs/Unit"
                      },
                      "value": {
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "unit",
                      "value"
                    ],
                    "type": "object"
                  },
                  "start": {
                    "$ref": "#/$defs/Text"
                  },
                  "temporal_role": {
                    "$ref": "#/$defs/Text"
                  },
