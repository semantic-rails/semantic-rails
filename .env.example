# Integration-sweep credentials for semantic-rails dialect testing.
#
# Copy to `.env` (gitignored), fill in real values, then `source .env`
# before `make test-integration`. Warehouses whose variables are unset
# simply SKIP in the conformance suite — the suite stays green.
#
# Convention (matches the package secrets policy):
#   - Secrets are NEVER literals in package.yml. The YAML stores the *name*
#     of an env var (e.g. `password_env: SR_POSTGRES_PASSWORD`) or a *path*
#     to a file. This file holds the actual values, kept out of git.
#   - Every cloud warehouse should use a dedicated least-privilege test
#     user/service account with DDL rights on ONE scratch schema/dataset.

# --- Local (docker) — defaults match docker-compose.warehouses.yml ---------

# Postgres (make warehouses-up)
SR_POSTGRES_HOST=127.0.0.1
SR_POSTGRES_PORT=5433
SR_POSTGRES_DATABASE=sr_jaffle
SR_POSTGRES_SCHEMA=public
SR_POSTGRES_USER=sr_test
SR_POSTGRES_PASSWORD=sr_test_pw

# ClickHouse (make warehouses-up) — HTTP port (clickhouse-connect)
SR_CLICKHOUSE_HOST=127.0.0.1
SR_CLICKHOUSE_PORT=8123
SR_CLICKHOUSE_DATABASE=sr_jaffle
SR_CLICKHOUSE_USER=sr_test
SR_CLICKHOUSE_PASSWORD=sr_test_pw

# DuckLake — no service: DuckDB extension + local catalog + data dir.
# Paths are created on first load.
SR_DUCKLAKE_CATALOG_PATH=data/.ducklake/catalog.ducklake
SR_DUCKLAKE_DATA_PATH=data/.ducklake/files

# --- Cloud ------------------------------------------------------------------

# BigQuery — file-based auth (service-account JSON).
#   Roles: BigQuery Data Editor + BigQuery Job User, scoped to the dataset.
#   Note: BigQuery Sandbox blocks INSERT DML — the fixture loader uses
#   parquet load jobs, which the sandbox allows.
GOOGLE_APPLICATION_CREDENTIALS=
SR_BIGQUERY_PROJECT=
SR_BIGQUERY_DATASET=

# Databricks — personal access token + a running SQL Warehouse.
SR_DATABRICKS_HOST=
SR_DATABRICKS_HTTP_PATH=
SR_DATABRICKS_TOKEN=
SR_DATABRICKS_CATALOG=
SR_DATABRICKS_SCHEMA=

# MotherDuck — single service token (reuses the DuckDB dialect).
SR_MOTHERDUCK_TOKEN=
SR_MOTHERDUCK_DATABASE=sr_jaffle

# Athena — AWS IAM + an S3 staging bucket (results + fixture parquet).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SR_ATHENA_S3_STAGING_DIR=
SR_ATHENA_DATABASE=

# Redshift Serverless — NOT WIRED YET (account pending verification).
# The connector is a documented stub; docs/ADDING_A_DIALECT.md walks
# through landing it. These names are reserved for that change:
SR_REDSHIFT_HOST=
SR_REDSHIFT_PORT=
SR_REDSHIFT_DATABASE=
SR_REDSHIFT_USER=
SR_REDSHIFT_PASSWORD=

# Snowflake — optional: the trial connection used during development.
SR_SNOWFLAKE_ACCOUNT=
SR_SNOWFLAKE_USER=
SR_SNOWFLAKE_PASSWORD=
SR_SNOWFLAKE_DATABASE=SR_JAFFLE
SR_SNOWFLAKE_SCHEMA=PUBLIC
SR_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
