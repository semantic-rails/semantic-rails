{
  "version": 1,
  "select": [
    {
      "expression": {
        "kind": "aggregate",
        "measure": "measure.jaffle.item_revenue_usd",
        "aggregation": "avg"
      },
      "as": "avg_item_revenue_usd"
    },
    {
      "expression": {
        "kind": "aggregate",
        "measure": "measure.jaffle.item_revenue_usd",
        "aggregation": "max"
      },
      "as": "max_item_revenue_usd"
    }
  ],
  "group_by": [
    "dimension.jaffle_item_product_type"
  ],
  "time": {
    "temporal_role": "temporal_role.jaffle_order_time",
    "grain": "month"
  },
  "order_by": [
    {
      "field": "temporal_role.jaffle_order_time__month",
      "direction": "ASC"
    }
  ]
}
