{
  "version": 1,
  "select": [
    {
      "expression": {
        "metric": "metric.jaffle.revenue_usd"
      },
      "as": "revenue_usd"
    }
  ],
  "group_by": [
    "dimension.jaffle_store_name"
  ],
  "time": {
    "temporal_role": "temporal_role.jaffle_order_time",
    "grain": "month"
  },
  "order_by": [
    {
      "field": "revenue_usd",
      "direction": "DESC"
    }
  ]
}
