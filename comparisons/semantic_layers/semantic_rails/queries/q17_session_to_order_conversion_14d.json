{
  "select": [
    {
      "expression": {
        "kind": "conversion",
        "entity": "entity.jaffle_customer",
        "window": {
          "unit": "day",
          "value": 14
        },
        "matching_mode": "first_converted_after_base",
        "base": "measure.jaffle.session_starts",
        "converted": "measure.jaffle.order_count"
      },
      "as": "session_to_order_conversion_rate_14d"
    }
  ],
  "time": {
    "temporal_role": "temporal_role.jaffle_session_started_at",
    "grain": "month"
  },
  "order_by": [
    {
      "field": "period",
      "direction": "asc"
    }
  ]
}
