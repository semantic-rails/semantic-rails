{
  "select": [
    {
      "expression": "metric.jaffle.orders",
      "as": "filtered_orders"
    }
  ],
  "where": [
    {
      "entity": "entity.jaffle_customer",
      "having": [
        {
          "field": "measure.jaffle.revenue_usd",
          "op": "gte",
          "value": 1000
        }
      ],
      "over": "all_time"
    }
  ],
  "time": {
    "temporal_role": "temporal_role.jaffle_order_time",
    "grain": "month"
  },
  "order_by": [
    {
      "field": "period",
      "direction": "asc"
    }
  ]
}
