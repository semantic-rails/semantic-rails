{
  "version": 1,
  "select": [
    {
      "expression": {
        "metric": "metric.jaffle.orders"
      },
      "as": "qualifying_orders"
    }
  ],
  "metric_filters": [
    {
      "expression": {
        "kind": "metric_predicate",
        "entity": "entity.jaffle_customer",
        "scope_mode": "contextual",
        "time_grain": "month",
        "input": {
          "measure": "measure.jaffle.order_count"
        },
        "op": ">",
        "value": 5
      },
      "op": "=",
      "value": true
    }
  ],
  "time": {
    "temporal_role": "temporal_role.jaffle_order_time",
    "grain": "month"
  },
  "order_by": [
    {
      "field": "temporal_role.jaffle_order_time__month",
      "direction": "ASC"
    }
  ]
}
