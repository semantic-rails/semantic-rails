{
  "dimensions": [
    {
      "field": "orders.ordered_at",
      "granularity": "month"
    }
  ],
  "include_empty": false,
  "limit": 5000,
  "measures": [
    "orders.revenue_usd",
    {
      "expr": "lag(sum(orders.order_total_cents / 100.0)) over (order by date_trunc('month', orders.ordered_at))",
      "name": "prior_month_revenue_usd"
    }
  ]
}