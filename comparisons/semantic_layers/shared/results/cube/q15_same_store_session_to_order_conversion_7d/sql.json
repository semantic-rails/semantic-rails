{"sql":{"external":false,"sql":["SELECT\n      DATE_TRUNC('month', timezone('UTC', \"session_conversions_7d_same_store\".started_at::timestamptz)) \"session_conversions_7d_same_store__started_at_month\", count(distinct CASE WHEN \"session_conversions_7d_same_store\".converted_within_7d THEN \"session_conversions_7d_same_store\".session_id END) * 1.0 / NULLIF(count(distinct \"session_conversions_7d_same_store\".session_id), 0) \"session_conversions_7d_same_store__same_store_session_to_order_conversion_rate_7d\"\n    FROM\n      (with matched as (\n  select\n    s.session_id,\n    s.customer_id,\n    s.store_id,\n    s.started_at,\n    min(o.ordered_at) as first_ordered_at\n  from comparison_storefront_sessions as s\n  left join comparison_orders as o\n    on s.customer_id = o.customer_id\n   and s.store_id = o.store_id\n   and o.ordered_at >= s.started_at\n   and o.ordered_at < s.started_at + interval '7 day'\n  group by 1, 2, 3, 4\n)\nselect\n  session_id,\n  customer_id,\n  store_id,\n  started_at,\n  case when first_ordered_at is not null then true else false end as converted_within_7d\nfrom matched\n) AS \"session_conversions_7d_same_store\"  GROUP BY 1 ORDER BY 1 ASC LIMIT 10000",[]],"lambdaQueries":{},"timeDimensionAlias":"session_conversions_7d_same_store__started_at_month","timeDimensionField":"session_conversions_7d_same_store.started_at","order":{"session_conversions_7d_same_store.started_at":"asc"},"cacheKeyQueries":[["SELECT FLOOR((UNIX_TIMESTAMP()) / 10) as refresh_key",[],{"external":true,"renewalThreshold":10}]],"preAggregations":[],"dataSource":"default","aliasNameToMember":{"session_conversions_7d_same_store__same_store_session_to_order_conversion_rate_7d":"session_conversions_7d_same_store.same_store_session_to_order_conversion_rate_7d","session_conversions_7d_same_store__started_at_month":"session_conversions_7d_same_store.started_at.month"},"rollupMatchResults":[],"canUseTransformedQuery":{"sortedDimensions":[],"sortedTimeDimensions":[["session_co