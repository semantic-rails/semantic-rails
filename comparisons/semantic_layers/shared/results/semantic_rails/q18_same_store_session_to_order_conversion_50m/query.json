{
  "order_by": [
    {
      "direction": "ASC",
      "field": "temporal_role.jaffle_session_started_at__month"
    }
  ],
  "select": [
    {
      "as": "same_store_conversion_rate_50m",
      "expression": {
        "base": {
          "measure": "measure.jaffle.session_starts"
        },
        "constant_properties": [
          "dimension.jaffle_store_name"
        ],
        "converted": {
          "measure": "measure.jaffle.order_count"
        },
        "entity": "entity.jaffle_customer",
        "kind": "conversion",
        "matching_mode": "first_converted_after_base",
        "window": {
          "unit": "minute",
          "value": 50
        }
      }
    }
  ],
  "time": {
    "grain": "month",
    "temporal_role": "temporal_role.jaffle_session_started_at"
  },
  "version": 1
}