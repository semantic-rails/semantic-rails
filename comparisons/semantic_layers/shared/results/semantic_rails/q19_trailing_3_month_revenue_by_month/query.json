{
  "order_by": [
    {
      "direction": "asc",
      "field": "period"
    }
  ],
  "select": [
    {
      "as": "trailing_3_month_revenue_usd",
      "expression": {
        "input": "measure.jaffle.revenue_usd",
        "kind": "rolling",
        "window": {
          "unit": "month",
          "value": 3
        }
      }
    }
  ],
  "time": {
    "grain": "month",
    "temporal_role": "temporal_role.jaffle_order_time"
  }
}