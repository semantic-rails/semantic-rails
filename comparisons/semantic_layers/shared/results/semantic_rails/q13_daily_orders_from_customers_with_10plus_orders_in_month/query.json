{
  "order_by": [
    {
      "direction": "ASC",
      "field": "temporal_role.jaffle_order_time__day"
    }
  ],
  "select": [
    {
      "as": "qualifying_orders",
      "expression": {
        "metric": "metric.jaffle.orders_from_customers_with_10plus_orders_in_period"
      }
    }
  ],
  "time": {
    "grain": "day",
    "temporal_role": "temporal_role.jaffle_order_time"
  },
  "version": 1
}