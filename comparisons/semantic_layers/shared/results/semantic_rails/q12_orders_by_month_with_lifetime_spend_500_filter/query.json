{
  "order_by": [
    {
      "direction": "asc",
      "field": "period"
    }
  ],
  "select": [
    {
      "as": "filtered_orders",
      "expression": "metric.jaffle.orders"
    }
  ],
  "time": {
    "grain": "month",
    "temporal_role": "temporal_role.jaffle_order_time"
  },
  "where": [
    {
      "entity": "entity.jaffle_customer",
      "having": [
        {
          "field": "metric.jaffle.lifetime_spend",
          "op": "gte",
          "value": 500
        }
      ],
      "over": "all_time"
    }
  ]
}