{
  "order_by": [
    {
      "direction": "asc",
      "field": "period"
    }
  ],
  "select": [
    "measure.jaffle.revenue_usd",
    {
      "as": "large_order_revenue_usd",
      "expression": {
        "aggregation": "sum",
        "kind": "scoped_aggregate",
        "measure": "measure.jaffle.revenue_usd",
        "predicates": [
          {
            "entity": "entity.jaffle_order",
            "measure": "measure.jaffle.revenue_usd",
            "op": "gte",
            "over": "period",
            "value": 50
          }
        ]
      }
    }
  ],
  "time": {
    "grain": "month",
    "temporal_role": "temporal_role.jaffle_order_time"
  }
}