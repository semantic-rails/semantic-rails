# Baseline sources keep the 4-table core concise and query-first.
source: stores is jaffle.table('comparison_stores') extend {
  primary_key: store_id
}

source: customers is jaffle.table('comparison_customers') extend {
  primary_key: customer_id
}

source: order_items is jaffle.table('comparison_order_items') extend {
  primary_key: item_id

  dimension: ordered_month is ordered_at.month

  measure: item_revenue_usd is item_revenue_cents.sum() / 100.0
}

source: orders is jaffle.table('comparison_orders') extend {
  primary_key: order_id

  join_one: stores with store_id
  join_one: customers with customer_id
  join_many: order_items on order_id = order_items.order_id

  dimension: ordered_month is ordered_at.month

  measure: orders is count()
  measure: revenue_usd is order_total_cents.sum() / 100.0
  measure: aov_usd is order_total_cents.avg() / 100.0
  measure: new_customer_orders is count() { where: is_new_customer_order = true }
}

# Stretch scope: an alternate clock, validity-window and event-window joins, and customer
# facts computed from orders by Malloy queries.
source: customer_history is jaffle.table('comparison_customer_history')

source: order_lifecycle is jaffle.table('comparison_order_lifecycle') extend {
  primary_key: order_id

  join_one: stores with store_id
  # The segment row valid at delivery; no valid row leaves the segment null.
  join_one: customer_history on customer_id = customer_history.customer_id
    and delivered_at >= customer_history.valid_from
    and (customer_history.valid_to is null or delivered_at < customer_history.valid_to)

  dimension: delivered_month is delivered_at.month

  measure: delivered_revenue_usd is order_total_cents.sum() / 100.0
}

source: storefront_sessions is jaffle.table('comparison_storefront_sessions') extend {
  primary_key: session_id

  # The same customer's orders placed within 7 days after the session started.
  join_many: orders_within_7d is orders on customer_id = orders_within_7d.customer_id
    and orders_within_7d.ordered_at > started_at
    and orders_within_7d.ordered_at <= started_at + 7 days

  dimension: session_month is started_at.month

  # count() counts each session once even when the join_many fans its rows out.
  measure: sessions is count()
  measure: converted_sessions is count() { where: orders_within_7d.order_id is not null }
  measure: conversion_rate_7d is converted_sessions / sessions
  measure: same_store_converted_sessions is count() { where: orders_within_7d.store_id = store_id }
  measure: same_store_conversion_rate_7d is same_store_converted_sessions / sessions
}

# Per-customer order facts, computed from orders by Malloy queries.
source: customer_order_facts is orders -> {
  group_by: customer_id
  aggregate:
    lifetime_orders is orders
    lifetime_spend_usd is revenue_usd
} extend {
  primary_key: customer_id
}

source: customer_month_orders is orders -> {
  group_by: customer_id, ordered_month
  aggregate: monthly_orders is orders
}

source: customer_store_month_orders is orders -> {
  group_by: customer_id, store_id, ordered_month
  aggregate: monthly_orders is orders
}

source: orders_with_customer_context is orders extend {
  # The segment row valid when the order was placed; no valid row leaves the segment null.
  join_one: customer_history on customer_id = customer_history.customer_id
    and ordered_at >= customer_history.valid_from
    and (customer_history.valid_to is null or ordered_at < customer_history.valid_to)
  join_one: customer_order_facts with customer_id
  join_one: customer_month_orders on customer_id = customer_month_orders.customer_id
    and ordered_month = customer_month_orders.ordered_month
  join_one: customer_store_month_orders on customer_id = customer_store_month_orders.customer_id
    and store_id = customer_store_month_orders.store_id
    and ordered_month = customer_store_month_orders.ordered_month
}

query: q01_orders_by_month is orders -> {
  group_by: ordered_month
  aggregate: orders
  order_by: ordered_month asc
  limit: 5000
}

query: q02_revenue_by_store_by_month is orders -> {
  group_by:
    ordered_month
    stores.store_name
  aggregate: revenue_usd
  order_by: ordered_month asc
  limit: 5000
}

query: q03_item_revenue_by_product_type_by_month is order_items -> {
  group_by:
    ordered_month
    product_type
  aggregate: item_revenue_usd
  order_by: ordered_month asc
  limit: 5000
}

query: q04_aov_by_store is orders -> {
  group_by: stores.store_name
  aggregate: aov_usd
  order_by: aov_usd desc
  limit: 5000
}

query: q05_orders_and_item_revenue_by_store_by_month is orders -> {
  group_by:
    ordered_month
    stores.store_name
  aggregate:
    orders
    order_items.item_revenue_usd
  order_by: ordered_month asc
  limit: 5000
}

query: q06_new_customer_orders_by_month is orders -> {
  group_by: ordered_month
  aggregate: new_customer_orders
  order_by: ordered_month asc
  limit: 5000
}

query: q07_delivered_revenue_by_month is order_lifecycle -> {
  group_by: delivered_month
  aggregate: delivered_revenue_usd
  order_by: delivered_month asc
  limit: 5000
}

query: q08_revenue_by_customer_segment_as_of_order_time is orders_with_customer_context -> {
  group_by:
    ordered_month
    customer_history.customer_segment
  aggregate: revenue_usd
  order_by: ordered_month asc
  limit: 5000
}

query: q09_session_to_order_conversion_7d is storefront_sessions -> {
  group_by: session_month
  aggregate: conversion_rate_7d
  order_by: session_month asc
  limit: 5000
}

query: q10_orders_from_customers_with_10plus_orders_in_month is orders_with_customer_context -> {
  where: customer_month_orders.monthly_orders > 10
  group_by: ordered_month
  aggregate: orders
  order_by: ordered_month asc
  limit: 5000
}

query: q11_repeat_customer_orders_by_store_by_month is orders_with_customer_context -> {
  where: customer_order_facts.lifetime_orders > 1
  group_by:
    ordered_month
    stores.store_name
  aggregate: orders
  order_by: ordered_month asc
  limit: 5000
}

query: q12_orders_by_month_with_lifetime_spend_500_filter is orders_with_customer_context -> {
  where: customer_order_facts.lifetime_spend_usd >= 500
  group_by: ordered_month
  aggregate: orders
  order_by: ordered_month asc
  limit: 5000
}

query: q13_daily_orders_from_customers_with_10plus_orders_in_month is orders_with_customer_context -> {
  where: customer_month_orders.monthly_orders > 10
  group_by: ordered_day is ordered_at.day
  aggregate: orders
  order_by: ordered_day asc
  limit: 5000
}

query: q14_revenue_from_customers_with_10plus_orders_same_store_month is orders_with_customer_context -> {
  where: customer_store_month_orders.monthly_orders > 10
  group_by:
    ordered_month
    stores.store_name
  aggregate: revenue_usd
  order_by: ordered_month asc
  limit: 5000
}

query: q15_same_store_session_to_order_conversion_7d is storefront_sessions -> {
  group_by: session_month
  aggregate: same_store_conversion_rate_7d
  order_by: session_month asc
  limit: 5000
}

query: q16_revenue_by_customer_segment_as_of_delivered_time is order_lifecycle -> {
  group_by:
    delivered_month
    customer_history.customer_segment
  aggregate: delivered_revenue_usd
  order_by: delivered_month asc
  limit: 5000
}
