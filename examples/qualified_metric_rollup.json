{
  "select": [
    {
      "expression": "measure.jaffle.order_count",
      "as": "orders"
    }
  ],
  "group_by": [
    "dimension.jaffle_store_name"
  ],
  "where": [
    {
      "entity": "entity.jaffle_customer",
      "having": [
        {
          "field": "measure.jaffle.order_count",
          "op": "gte",
          "value": 4
        }
      ],
      "over": "all_time"
    }
  ],
  "time": {
    "temporal_role": "temporal_role.jaffle_order_time",
    "grain": "month"
  },
  "order_by": [
    {
      "field": "orders",
      "direction": "desc"
    }
  ],
  "limit": 10
}
