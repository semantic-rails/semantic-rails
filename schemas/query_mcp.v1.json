{
  "$id": "https://semantic-rails.com/schemas/query_mcp.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "interface_version": "v1",
  "manifest_version": 1,
  "mcp_protocol": {
    "default": "2025-11-25",
    "supported": [
      "2025-11-25",
      "2025-03-26",
      "2024-11-05"
    ]
  },
  "producer": {
    "name": "semantic-rails",
    "version": "0.3.1"
  },
  "prompts": [
    {
      "arguments": [
        {
          "description": "Business question or analysis goal.",
          "name": "intent",
          "required": true
        },
        {
          "description": "Semantic layer package id.",
          "name": "package_id",
          "required": false
        }
      ],
      "description": "Guide an agent from a question to rows: discover, inspect, plan (or build-options and valid-values), then execute.",
      "name": "semantic-rails-query-builder"
    },
    {
      "arguments": [
        {
          "description": "Query IR JSON to review.",
          "name": "query_json",
          "required": true
        }
      ],
      "description": "Review existing Query IR with validate and compile (its response includes the `explain` payload) before execution.",
      "name": "semantic-rails-query-review"
    },
    {
      "arguments": [
        {
          "description": "Segment id such as segment.jaffle.high_value_customers.",
          "name": "segment_id",
          "required": true
        }
      ],
      "description": "Validate, segment-explain, and segment-preview a package-authored segment.",
      "name": "semantic-rails-segment-workflow"
    }
  ],
  "resources": [
    {
      "description": "V1 capabilities with complete tool definitions, resources and prompts. Large; use capabilities/summary for names and titles.",
      "mimeType": "application/json",
      "name": "capabilities",
      "uri": "semantic-rails://capabilities"
    },
    {
      "description": "Small capabilities index: tool names and titles, plus resources and prompts.",
      "mimeType": "application/json",
      "name": "capabilities-summary",
      "uri": "semantic-rails://capabilities/summary"
    },
    {
      "description": "V1 catalog summary with descriptive rows and counts. Large; use catalog/index for counts and ids.",
      "mimeType": "application/json",
      "name": "catalog-summary",
      "uri": "semantic-rails://catalog/summary"
    },
    {
      "description": "Small catalog index: counts and ids per object kind for the active package.",
      "mimeType": "application/json",
      "name": "catalog-index",
      "uri": "semantic-rails://catalog/index"
    },
    {
      "description": "Every object's full card and the alias index for the active package. Large: start with catalog-index.",
      "mimeType": "application/json",
      "name": "catalog-full",
      "uri": "semantic-rails://catalog/full"
    }
  ],
  "resultSchema": {
    "$defs": {
      "issue": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "recovery_hints": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "severity": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "Semantic Rails MCP result envelope. Tool-specific fields are additive; the status, issue, request, and package fields are stable v1.",
    "properties": {
      "api_version": {
        "const": "v1",
        "type": "string"
      },
      "error": {
        "oneOf": [
          {
            "$ref": "#/$defs/issue"
          },
          {
            "type": "null"
          }
        ]
      },
      "errors": {
        "items": {
          "$ref": "#/$defs/issue"
        },
        "type": "array"
      },
      "ok": {
        "type": "boolean"
      },
      "package_id": {
        "type": "string"
      },
      "recovery_hints": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "request_context": {
        "type": "object"
      },
      "request_id": {
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "warning",
          "error",
          "low_confidence",
          "unrealizable",
          "out_of_scope"
        ],
        "type": "string"
      },
      "timing_ms": {
        "minimum": 0,
        "type": "number"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/issue"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "status",
      "api_version",
      "request_id",
      "package_id",
      "warnings",
      "errors"
    ],
    "type": "object"
  },
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Capabilities"
      },
      "description": "Semantic Rails MCP question-answering entrypoint: answer with discover, plan and execute (validate and compile are optional dry runs); use catalog to list ids. Returns what this package supports and doesn't: rolling windows, prior-period offsets, metric predicates, scoped aggregates, conversion metrics, with runnable expression_shapes examples. Gotcha: capabilities are package-scoped; call again after switching packages.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "request_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "capabilities",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v1 result envelope.",
        "properties": {
          "api_version": {
            "const": "v1",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Catalog"
      },
      "description": "List the governed objects in the package: measures, metrics, dimensions, segments and entities. Use it first to see what exists; prefer 'discover' to look up terms. Gotcha: the default verbosity 'summary' returns flat id lists; 'compact' adds row metadata (capped at 200 per kind) and 'full' is uncapped with alias_index (large).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "entity": {
            "description": "Optional root entity context.",
            "type": "string"
          },
          "kind": {
            "description": "Optional object kind filter.",
            "type": "string"
          },
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "search": {
            "description": "Optional substring filter.",
            "type": "string"
          },
          "verbosity": {
            "default": "summary",
            "enum": [
              "summary",
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          },
          "view": {
            "default": "summary",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "catalog",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v1 result envelope.",
        "properties": {
          "api_version": {
            "const": "v1",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Discover"
      },
      "description": "Rank semantic objects against business terms (e.g. 'revenue', 'aov by store'). Returns measures, metrics, dimensions, and entities, up to 'limit' per kind. Default: full cards; verbosity='minimal': slim cards without match_reasons or starter patches. Gotcha: nonsense terms return 'out_of_scope' or 'low_relevance' with empty buckets; branch before using a candidate.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "kinds": {
            "description": "Object kinds to rank, such as measure or metric. Default: all.",
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ]
          },
          "limit": {
            "default": 10,
            "minimum": 1,
            "type": "integer"
          },
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "additionalProperties": true,
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'validate' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "stage": {
            "description": "Builder stage that tunes ranking: initial, post_measure, post_dimension or comparison. Inferred when omitted.",
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "verbosity": {
            "default": "compact",
            "enum": [
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "discover",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v1 result envelope.",
        "properties": {
          "api_version": {
            "const": "v1",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Inspect"
      },
      "description": "Return one object's card: label, description, aggregations or values, temporal roles, related objects, policy. Default: full card; verbosity='minimal' drops duplicates. Gotcha: 'object_id' must be a full id like 'measure.jaffle.revenue_usd', not a label — use 'discover' first if you only have a phrase.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "additionalProperties": true,
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'validate' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "verbosity": {
            "default": "compact",
            "enum": [
              "minimal",
              "compact",
              "full"
            ],
            "type": "string"
          }
        },
        "required": [
          "object_id"
        ],
        "type": "object"
      },
      "name": "inspect",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v1 result envelope.",
        "properties": {
          "api_version": {
            "const": "v1",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Build Options"
      },
      "description": "Return ranked next choices for a guided query builder: given partial Query IR, which dimension, filter or time range to add next. Use it to compose a query step by step instead of from one intent ('plan'). Gotcha: pass the partial 'query' you've assembled; empty input returns initial-stage options.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "focus_object_id": {
            "description": "An object id to rank the options around.",
            "type": "string"
          },
          "focus_terms": {
            "description": "Terms to rank the options by.",
            "type": "string"
          },
          "include_blocked": {
            "default": true,
            "description": "Also list options this query can't use, with the reason.",
            "type": "boolean"
          },
          "limit": {
            "default": 10,
            "minimum": 1,
            "type": "integer"
          },
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "additionalProperties": true,
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'validate' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "stage": {
            "description": "Builder stage that tunes ranking: initial, post_measure, post_dimension or comparison. Inferred when omitted.",
            "type": "string"
          },
          "step": {
            "description": "Step to rank options for: measure, group_by, filter_dimension, time or review. Inferred from 'query' when omitted.",
            "type": "string"
          },
          "verbosity": {
            "default": "compact",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "build-options",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v1 result envelope.",
        "properties": {
          "api_version": {
            "const": "v1",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Valid Values"
      },
      "description": "Return a dimension's governed values: from its declared value domain, or from a constrained warehouse probe with allow_live_query: true. Use it before writing a 'where' filter on a categorical dimension. Gotcha: 'dimension_id' must be a full id like 'dimension.jaffle_store_name'; allow_live_query costs a warehouse round-trip, so use it only when no domain is declared.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "allow_live_query": {
            "default": false,
            "type": "boolean"
          },
          "dimension_id": {
            "type": "string"
          },
          "include_counts": {
            "default": false,
            "description": "With allow_live_query, add each value's row count.",
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "additionalProperties": true,
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'validate' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "search": {
            "type": "string"
          }
        },
        "required": [
          "dimension_id"
        ],
        "type": "object"
      },
      "name": "valid-values",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v1 result envelope.",
        "properties": {
          "api_version": {
            "const": "v1",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Plan"
      },
      "description": "Single public intent-planning surface: natural-language intent → one best Query IR. Returns 'status' ('ok' | 'low_confidence' | 'unrealizable' | 'out_of_scope'), 'best.query_ir', and 'why' or 'warnings' naming any part of the question the draft doesn't honor. 'status=ok' has already paid validation cost, so agents may pass 'best.query_ir' to 'execute'. By default the v1 response includes intent_ir, trace and next steps; detail='query' opts into a compact response. 'full' adds alternatives and blocked drafts; 'debug' adds compose_hints. Gotcha: read 'status' and 'warnings' before running 'best.query_ir'.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "default": "best",
            "enum": [
              "query",
              "best",
              "full",
              "debug"
            ],
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "limit": {
            "default": 3,
            "description": "Drafts to consider; detail='full' returns the runners-up.",
            "minimum": 1,
            "type": "integer"
          },
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "additionalProperties": true,
            "description": "Semantic Layer Query IR (JSON object). IR + time-block shape: see the 'validate' tool schema, or schemas/query_ir.v1.json.",
            "type": "object"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "intent"
        ],
        "type": "object"
      },
      "name": "plan",
      "outputSchema": {
        "additionalProperties": true,
        "description": "Semantic Rails MCP v1 result envelope.",
        "properties": {
          "api_version": {
            "const": "v1",
            "type": "string"
          },
          "errors": {
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "package_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "warnings": {
            "type": "array"
          }
        },
        "required": [
          "ok",
          "status"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Validate"
      },
      "description": "Check Query IR without running it: errors, warnings and repair hints. Optional: 'execute' runs the same checks first. Gotcha: 'query' must be a JSON object, not a string; wrap it as {query: {...}}. verbosity='compact' or 'full' adds the normalized query, policy effects and plans. IR: select[]={expression,as}, group_by[]=[<dim>,...] (bare ids), where[]={field,op,value}, order_by[]={field,direction}. select.expression: {aggregation, measure} | {metric} | {kind:prior_period|rolling|cumulative|ratio|conversion|aggregate_if|between|...}. Runnable examples per kind: capabilities.expression_shapes[].example.",
      "inputSchema": {
        "additionalProperties": true,
        "properties": {
          "policy_context": {
            "additionalProperties": true,
            "description": "Optional visibility/access policy context.",
            "properties": {
              "audience": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "query": {
            "additionalProperties": true,
            "description": "Semantic Layer Query IR. Full spec at schemas/query_ir.v1.json; narrative at docs/QUERY_IR_SCHEMA.md. Unknown keys rejected as INVALID_QUERY (offenders under details.unsupported_keys).",
            "properties": {
              "time": {
                "additionalProperties": true,
                "description": "Time anchor: temporal_role + grain + start|end|range + fill + calendar_id. Omit entirely for an all-time scalar aggregate.",
                "properties": {
                  "calendar_id": {
                    "default": "default",
                    "description": "Calendar for dense spine (Gregorian or authored fiscal).",
                    "type": "string"
                  },
                  "end": {
                    "description": "ISO-8601.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fill": {
                    "default": false,
                    "description": "Dense calendar spine for grain buckets (0 / NULL fill). Requires grain; otherwise fails as INVALID_QUERY.",
                    "type": "boolean"
                  },
                  "grain": {
                    "description": "Bucket size. Required when fill=true or for inline prior_period.",
                    "enum": [
                      "",
                      "day",
                      "week",
                      "month",
                      "quarter",
                      "year",
                      "hour",
                      "minute"
                    ],
                    "type": "string"
                  },
                  "range": {
                    "additionalProperties": true,
